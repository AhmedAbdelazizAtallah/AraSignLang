APP_NAME=Arabic Sign Language AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-in-production
MODEL_BACKEND=onnx
ONNX_MODEL_PATH=backend/models/yolov26s.onnx
MODEL_PATH=backend/models/yolov26s.pt
MODEL_IMG_SIZE=416
DEVICE=auto
HALF_PRECISION=true
CONF_THRESHOLD=0.55
IOU_THRESHOLD=0.45
STABILITY_WINDOW=8
STABILITY_MIN_VOTES=5
ACCEPT_THRESHOLD=0.70
COOLDOWN_SECONDS=1.0
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
